# Only software files at the project root are eligible for upload.
/*
!/.gitignore
!/README.md
!/CONTEXT.md
!/app.py
!/start.bat
!/EnglishDictation.exe
!/EnglishDictation.spec
!/requirements.txt
!/requirements-dev.txt
!/pytest.ini
!/src/
!/tests/
!/tools/
!/packaging_hooks/
!/assets/
!/docs/

